# BalanceVault / LedgerLine Database Configuration
# Primary application database URL
DATABASE_URL="postgresql://ledgerline_app:your_secure_password@localhost:5432/ledgerline?schema=public"

# Database Owner / Migration connection URL (used for migrations and schema DDL)
DATABASE_MIGRATION_URL="postgresql://postgres:root@localhost:5432/ledgerline?schema=public"

# Isolated test database URL for automated integration tests
TEST_DATABASE_URL="postgresql://postgres:root@localhost:5432/ledgerline_test?schema=public"

# PostgreSQL connection options
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="ledgerline"
PGUSER="ledgerline_app"
PGPASSWORD="your_secure_password"

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
