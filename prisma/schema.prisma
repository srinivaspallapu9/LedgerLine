datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR

  @@map("user_role")
}

enum AccountType {
  CUSTOMER
  SYSTEM

  @@map("account_type")
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED

  @@map("account_status")
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED

  @@map("transaction_status")
}

enum EntryDirection {
  DEBIT
  CREDIT

  @@map("entry_direction")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(120)
  email        String   @unique(map: "uq_users_email") @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(ACCOUNT_HOLDER)
  isEnabled    Boolean  @default(true) @map("is_enabled")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts              Account[]
  initiatedTransactions FinancialTransaction[]
  idempotencyRecords    IdempotencyRecord[]
  auditEvents           AuditEvent[]

  @@map("users")
}

model Account {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountNumber String       @unique(map: "uq_accounts_account_number") @map("account_number") @db.VarChar(32)
  ownerUserId  String?       @map("owner_user_id") @db.Uuid
  accountType  AccountType   @default(CUSTOMER) @map("account_type")
  status       AccountStatus @default(ACTIVE)
  currency     String        @default("INR") @db.Char(3)
  balancePaise BigInt        @default(0) @map("balance_paise")
  version      BigInt        @default(0)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner                   User?                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  sourceTransactions      FinancialTransaction[] @relation("SourceAccount")
  destinationTransactions FinancialTransaction[] @relation("DestinationAccount")
  ledgerEntries           LedgerEntry[]

  @@index([ownerUserId, status], map: "idx_accounts_owner_status")
  @@map("accounts")
}

model FinancialTransaction {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionRef       String            @unique(map: "uq_financial_transactions_ref") @map("transaction_ref") @db.VarChar(40)
  transactionType      TransactionType   @map("transaction_type")
  status               TransactionStatus @default(PENDING)
  amountPaise          BigInt            @map("amount_paise")
  currency             String            @default("INR") @db.Char(3)
  sourceAccountId      String?           @map("source_account_id") @db.Uuid
  destinationAccountId String?           @map("destination_account_id") @db.Uuid
  initiatedByUserId    String?           @map("initiated_by_user_id") @db.Uuid
  description          String?           @db.VarChar(250)
  failureCode          String?           @map("failure_code") @db.VarChar(60)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt             DateTime?         @map("posted_at") @db.Timestamptz(6)

  sourceAccount      Account?            @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  destinationAccount Account?            @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  initiatedByUser    User?               @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  ledgerEntries      LedgerEntry[]
  idempotencyRecords IdempotencyRecord[]

  @@index([sourceAccountId, createdAt(sort: Desc)], map: "idx_transactions_source_created")
  @@index([destinationAccountId, createdAt(sort: Desc)], map: "idx_transactions_destination_created")
  @@index([status, createdAt], map: "idx_transactions_status_created")
  @@map("financial_transactions")
}

model LedgerEntry {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  direction     EntryDirection
  amountPaise   BigInt         @map("amount_paise")
  currency      String         @default("INR") @db.Char(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId], map: "idx_ledger_transaction")
  @@index([accountId, createdAt(sort: Desc)], map: "idx_ledger_account_created")
  @@map("ledger_entries")
}

model IdempotencyRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  requestHash    String    @map("request_hash") @db.Char(64)
  transactionId  String?   @map("transaction_id") @db.Uuid
  responseStatus Int?      @map("response_status") @db.SmallInt
  responseBody   Json?     @map("response_body")
  state          String    @default("IN_PROGRESS") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  user        User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey], map: "uq_idempotency_user_key")
  @@index([createdAt], map: "idx_idempotency_created")
  @@map("idempotency_records")
}

model AuditEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(80)
  resourceType  String    @map("resource_type") @db.VarChar(80)
  resourceId    String?   @map("resource_id") @db.Uuid
  outcome       String    @db.VarChar(20)
  correlationId String?   @map("correlation_id") @db.Uuid
  ipAddress     String?   @map("ip_address") @db.Inet
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  details       Json      @default("{}")
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, occurredAt(sort: Desc)], map: "idx_audit_actor_time")
  @@index([resourceType, resourceId, occurredAt(sort: Desc)], map: "idx_audit_resource_time")
  @@index([correlationId], map: "idx_audit_correlation")
  @@map("audit_events")
}

